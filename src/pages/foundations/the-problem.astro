---
import { getEntry, render } from 'astro:content';
import Layout from '../../components/Layout.astro';

const entry = await getEntry('chapter', 'the-problem');
if (!entry) throw new Error('Missing content entry: chapter/the-problem');
const { Content, headings } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.question}
  question={entry.data.question}
  headings={headings}
>
  <Content />

  <details class="sources">
    <summary>Sources</summary>
    <ul>
      {entry.data.sources.map((s) => (
        <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a></li>
      ))}
    </ul>
  </details>
</Layout>

<style>
  .sources {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-base);
    font-size: var(--text-sm);
    color: var(--ink-500);
  }
  .sources summary { cursor: pointer; color: var(--ink-700); }
  .sources ul { margin-top: var(--space-sm); padding-left: var(--space-base); }
</style>
