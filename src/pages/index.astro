---
import Layout from '../components/Layout.astro';
import { href } from '../lib/url';

const workflows = ['Sense', 'Focus', 'Design', 'Attract', 'Orchestrate', 'Execute', 'Learn'];
---

<Layout
  title="Home"
  description="A field guide to the Intelligent Marketing Operating System — a public handbook teaching AI-native marketing from first principles."
>
  <h1 class="hero-title">The AI-Native Marketing Handbook</h1>
  <p class="hero-subtitle">
    A field guide to the Intelligent Marketing Operating System — for a marketer who's
    never touched AI, an engineer who's never touched marketing, or anyone else starting
    from zero.
  </p>

  <figure class="workflow-diagram" role="img" aria-label="The seven I-MOS workflows — Sense, Focus, Design, Attract, Orchestrate, Execute, Learn — running in a continuous loop wrapped in a Govern envelope.">
    <svg viewBox="0 0 920 220" xmlns="http://www.w3.org/2000/svg">
      <title>The seven workflows</title>
      <desc>
        Seven connected stages — Sense, Focus, Design, Attract, Orchestrate, Execute,
        Learn — arranged left to right with an arrow from Learn back to Sense, showing
        the loop closes. A band beneath all seven represents Govern, running underneath
        every stage continuously.
      </desc>
      <rect x="0" y="150" width="920" height="40" rx="4" fill="var(--surface-2)" />
      <text x="460" y="174" text-anchor="middle" fill="var(--ink-500)" font-size="13" font-family="var(--font-body)">GOVERN — runs beneath every workflow, continuously</text>

      {workflows.map((name, i) => {
        const x = 20 + i * 130;
        return (
          <g>
            <rect x={x} y="20" width="110" height="100" rx="6" fill="var(--teal-100)" stroke="var(--teal-700)" stroke-width="1" />
            <text x={x + 55} y="75" text-anchor="middle" fill="var(--ink-900)" font-size="16" font-family="var(--font-display)" font-weight="500">{name}</text>
            {i < workflows.length - 1 && (
              <line x1={x + 110} y1="70" x2={x + 130} y2="70" stroke="var(--ink-500)" stroke-width="1.5" marker-end="url(#arrow)" />
            )}
          </g>
        );
      })}
      <path d="M 75 120 C 75 210, 845 210, 845 120" fill="none" stroke="var(--amber-600)" stroke-width="1.5" marker-end="url(#arrow-amber)" />
      <text x="460" y="215" text-anchor="middle" fill="var(--amber-600)" font-size="12" font-family="var(--font-body)">Learn writes back to Sense — the loop compounds</text>
      <defs>
        <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="var(--ink-500)" />
        </marker>
        <marker id="arrow-amber" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="var(--amber-600)" />
        </marker>
      </defs>
    </svg>
    <figcaption>
      D1 — The seven I-MOS workflows, wrapped in a continuous Govern envelope. Every
      chapter in Parts II and III zooms into one node of this diagram.
    </figcaption>
  </figure>

  <nav class="reading-paths" aria-label="Reading paths">
    <h2>Three ways in</h2>
    <ul>
      <li>
        <a href={href('start-here')}>Start here</a>
        <span>How to use this handbook, and three reading paths matched to your background.</span>
      </li>
      <li>
        <a href={href('foundations/the-problem')}>Read the problem first</a>
        <span>The four symptoms of a disconnected marketing operation — why this exists at all.</span>
      </li>
    </ul>
  </nav>
</Layout>

<style>
  .hero-title {
    font-size: var(--text-display);
    max-width: 16ch;
    margin-bottom: var(--space-base);
  }
  .hero-subtitle {
    font-size: var(--text-md);
    color: var(--ink-500);
    max-width: 60ch;
    margin-bottom: var(--space-2xl);
  }
  .workflow-diagram {
    margin: 0 0 var(--space-2xl);
  }
  .workflow-diagram svg { width: 100%; height: auto; }
  .workflow-diagram figcaption {
    font-size: var(--text-xs);
    color: var(--ink-500);
    margin-top: var(--space-xs);
    max-width: var(--measure);
  }
  .reading-paths h2 { margin-bottom: var(--space-base); }
  .reading-paths ul { list-style: none; padding: 0; display: grid; gap: var(--space-lg); }
  .reading-paths a {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    color: var(--teal-700);
    text-decoration: none;
  }
  .reading-paths span {
    display: block;
    color: var(--ink-500);
    font-size: var(--text-sm);
    margin-top: var(--space-2xs);
  }

  @media (max-width: 640px) {
    .workflow-diagram svg { min-width: 760px; }
    .workflow-diagram { overflow-x: auto; }
  }
</style>
