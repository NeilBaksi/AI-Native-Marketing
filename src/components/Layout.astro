---
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from './Footer.astro';
import { nav } from '../data/nav';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  question?: string;
  headings?: { depth: number; text: string; slug: string }[];
}

const { title, description, question, headings = [] } = Astro.props;
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');

const CSP = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "worker-src 'self' blob:",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "base-uri 'self'",
  "form-action 'none'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <title>{title} — The AI-Native Marketing Handbook</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={href('fonts/piazzolla-variable.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('fonts/public-sans-variable.woff2')} crossorigin />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="shell">
      <header class="topbar">
        <a href={href('')} class="wordmark">The AI-Native Marketing Handbook</a>
        <div class="topbar-actions">
          <button type="button" data-search-toggle aria-expanded="false" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.5" />
              <path d="M13 13L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
          <button type="button" data-theme-toggle data-theme-state="system" aria-label="Theme: system. Click to change.">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.5" />
              <path d="M10 4v12" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
          <button type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" class="hamburger" aria-label="Open navigation">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </header>

      <div class="search-panel" data-search-panel data-open="false" role="dialog" aria-modal="true" aria-label="Search">
        <input type="search" data-search-input placeholder="Search the handbook…" aria-label="Search query" />
        <ul data-search-results></ul>
      </div>

      <nav class="rail" aria-label="Handbook navigation">
        {nav.map((part) => (
          <div class="rail-part">
            <p class="rail-part-label">{part.label}</p>
            <ul>
              {part.pages.map((page) => (
                <li>
                  <a href={href(page.path)} aria-current={currentPath.includes(page.path) ? 'page' : undefined}>
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <nav id="mobile-nav" class="mobile-sheet" data-nav-sheet data-open="false" aria-label="Handbook navigation">
        <div class="mobile-sheet-panel">
          {nav.map((part) => (
            <div class="rail-part">
              <p class="rail-part-label">{part.label}</p>
              <ul>
                {part.pages.map((page) => (
                  <li><a href={href(page.path)}>{page.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>

      <main id="main">
        {question && (
          <p class="the-question">{question}</p>
        )}
        <slot />
      </main>

      {headings.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <p class="toc-label">On this page</p>
          <ul>
            {headings.filter((h) => h.depth <= 2).map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </aside>
      )}

      <Footer />
    </div>

    <script src="../scripts/theme.js"></script>
    <script src="../scripts/mobile-nav.js"></script>
    <script src="../scripts/search.js"></script>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'topbar'
      'main'
      'footer';
  }
  .topbar {
    grid-area: topbar;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-base);
    border-bottom: 1px solid var(--rule);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink-900);
    text-decoration: none;
    font-size: var(--text-md);
  }
  .topbar-actions { display: flex; gap: var(--space-xs); }
  .topbar-actions button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--ink-700);
    cursor: pointer;
  }
  .topbar-actions button:hover { background: var(--surface); }

  .rail { display: none; }
  .mobile-sheet {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
  }
  .mobile-sheet[data-open='true'] {
    display: block;
    background: color-mix(in oklab, var(--ink-900) 40%, transparent);
  }
  .mobile-sheet-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: var(--paper);
    padding: var(--space-lg) var(--space-base);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--duration-panel) var(--ease-out);
  }
  .mobile-sheet[data-open='true'] .mobile-sheet-panel { transform: translateX(0); }

  .rail-part-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-300);
    margin-block: var(--space-md) var(--space-xs);
  }
  .rail-part ul { list-style: none; padding: 0; }
  .rail-part a {
    display: block;
    padding: var(--space-xs) 0;
    color: var(--ink-700);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .rail-part a[aria-current='page'] {
    color: var(--teal-700);
    font-weight: 600;
    border-left: 2px solid var(--teal-700);
    padding-left: var(--space-xs);
    margin-left: calc(-1 * var(--space-xs) - 2px);
  }

  main {
    grid-area: main;
    padding: var(--space-lg) var(--space-base) var(--space-2xl);
    max-width: var(--measure);
    margin-inline: auto;
    width: 100%;
  }
  .the-question {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--teal-700);
    margin-bottom: var(--space-lg);
  }

  .toc { display: none; }

  .search-panel {
    display: none;
    position: fixed;
    top: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, 92vw);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: var(--space-base);
    z-index: 60;
    box-shadow: none;
  }
  .search-panel[data-open='true'] { display: block; }
  .search-panel input {
    width: 100%;
    font-size: var(--text-base);
    padding: var(--space-sm);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink-900);
  }
  .search-panel ul { list-style: none; padding: 0; margin-top: var(--space-sm); }
  .search-panel li a {
    display: block;
    padding: var(--space-xs);
    color: var(--ink-700);
    text-decoration: none;
  }
  .search-panel li a:hover { background: var(--surface); }
  .search-panel li strong { display: block; color: var(--ink-900); }
  .search-panel li span { display: block; font-size: var(--text-xs); color: var(--ink-500); }

  @media (min-width: 768px) {
    .hamburger { display: none; }
  }

  @media (min-width: 1024px) {
    .shell {
      grid-template-columns: var(--rail-width) minmax(0, 1fr);
      grid-template-areas:
        'topbar topbar'
        'rail   main'
        'footer footer';
    }
    .rail {
      display: block;
      grid-area: rail;
      border-right: 1px solid var(--rule);
      padding: var(--space-lg) var(--space-base);
      align-self: start;
      position: sticky;
      top: 0;
      height: 100dvh;
      overflow-y: auto;
    }
    .hamburger { display: none; }
    main { margin-inline: var(--space-xl); }
  }

  @media (min-width: 1280px) {
    .shell {
      grid-template-columns: var(--rail-width) minmax(0, 1fr) var(--toc-width);
      grid-template-areas:
        'topbar topbar topbar'
        'rail   main   toc'
        'footer footer footer';
    }
    .toc {
      display: block;
      grid-area: toc;
      padding: var(--space-lg) var(--space-base);
      align-self: start;
      position: sticky;
      top: 0;
      font-size: var(--text-xs);
    }
    .toc-label {
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-300);
      margin-bottom: var(--space-xs);
    }
    .toc ul { list-style: none; padding: 0; }
    .toc a {
      display: block;
      padding: var(--space-2xs) 0;
      color: var(--ink-500);
      text-decoration: none;
    }
    .toc a:hover { color: var(--teal-700); }
  }
</style>
